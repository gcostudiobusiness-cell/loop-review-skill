diff --git a/public/app.js b/public/app.js
index 8690ea1..670d96f 100644
--- a/public/app.js
+++ b/public/app.js
@@ -2,13 +2,29 @@ import { validate } from './validate.js';
 
 const form = document.getElementById('settings');
 const save = document.getElementById('save');
+const status = document.getElementById('status');
 
 save.addEventListener('click', async () => {
   const data = Object.fromEntries(new FormData(form));
   const errors = validate(data);
   for (const field of ['name', 'email', 'phone']) {
-    document.getElementById(field).classList.toggle('invalid', Boolean(errors[field]));
+    const input = document.getElementById(field);
+    const message = errors[field] ?? '';
+    input.classList.toggle('invalid', Boolean(message));
+    input.setAttribute('aria-invalid', message ? 'true' : 'false');
+    document.getElementById(`${field}-error`).textContent = message;
+  }
+  if (Object.keys(errors).length) {
+    status.textContent = 'Check the highlighted fields and try again.';
+    return;
+  }
+  status.textContent = 'Saving…';
+  try {
+    const res = await fetch('/api/settings', { method: 'PUT', body: JSON.stringify(data) });
+    status.textContent = res.ok
+      ? 'Settings saved.'
+      : 'Could not save your settings. Please try again.';
+  } catch {
+    status.textContent = 'Could not save your settings. Please try again.';
   }
-  if (Object.keys(errors).length) return;
-  await fetch('/api/settings', { method: 'PUT', body: JSON.stringify(data) });
 });
