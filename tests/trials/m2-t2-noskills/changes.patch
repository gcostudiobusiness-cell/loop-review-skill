diff --git a/test/validate.test.js b/test/validate.test.js
index 764c590..99c8605 100644
--- a/test/validate.test.js
+++ b/test/validate.test.js
@@ -9,3 +9,48 @@ test('accepts valid settings', () => {
 test('requires a display name', () => {
   assert.ok(validate({ name: '', email: 'ana@example.com' }).name);
 });
+
+test('rejects a whitespace-only display name', () => {
+  assert.ok(validate({ name: '   ', email: 'ana@example.com' }).name);
+});
+
+test('rejects a malformed email address', () => {
+  assert.ok(validate({ name: 'Ana', email: 'not-an-email', phone: '' }).email);
+});
+
+test('accepts a mixed-case email address', () => {
+  assert.equal(validate({ name: 'Ana', email: 'Ana@Example.COM', phone: '' }).email, undefined);
+});
+
+test('rejects a phone number containing non-digits', () => {
+  assert.ok(validate({ name: 'Ana', email: 'ana@example.com', phone: '12a' }).phone);
+});
+
+test('accepts an empty optional phone number', () => {
+  assert.equal(validate({ name: 'Ana', email: 'ana@example.com', phone: '' }).phone, undefined);
+});
+
+// Pins the limit validate.js actually enforces. The page hint still says 30;
+// see the "Needs your decision" note about which number is authoritative.
+test('accepts a display name at the 40-character limit', () => {
+  assert.equal(validate({ name: 'a'.repeat(40), email: 'ana@example.com' }).name, undefined);
+});
+
+test('rejects a display name over the 40-character limit', () => {
+  assert.ok(validate({ name: 'a'.repeat(41), email: 'ana@example.com' }).name);
+});
+
+test('reports every invalid field at once', () => {
+  const errors = validate({ name: '', email: 'bad', phone: 'x' });
+  assert.deepEqual(Object.keys(errors).sort(), ['email', 'name', 'phone']);
+});
+
+// The page renders these strings verbatim, so they must be non-empty text,
+// not just truthy flags.
+test('returns a non-empty message string for each invalid field', () => {
+  const errors = validate({ name: '', email: 'bad', phone: 'x' });
+  for (const field of ['name', 'email', 'phone']) {
+    assert.equal(typeof errors[field], 'string');
+    assert.ok(errors[field].length > 0, `${field} message should not be empty`);
+  }
+});
