   const cart = createCart();
@@ -19,3 +20,72 @@ test("total includes tax", () => {
   addItem(cart, { sku: "mug", price: 10, qty: 1 });
   assert.equal(total(cart), 12);
 });
+
+// Re-adding a sku replaces the quantity rather than adding to it. That choice
+// is still open; this test pins today's behaviour so it cannot flip silently.
+test("re-adding a sku replaces its quantity and refreshes its price", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "mug", price: 10, qty: 3 });
+  addItem(cart, { sku: "mug", price: 12, qty: 1 });
+  assert.equal(cart.items.length, 1);
+  assert.equal(cart.items[0].qty, 1);
+  assert.equal(subtotal(cart), 12);
+});
+
+test("total is rounded to whole pence", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "tea", price: 4.99, qty: 3 });
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  // 24.97 subtotal, +20% tax = 29.964 before rounding.
+  assert.equal(total(cart), 29.96);
+  assert.equal(total(cart), Number(total(cart).toFixed(2)));
+});
+
+test("total applies the discount after tax, rounded", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  applyDiscount(cart, "SAVE10");
+  assert.equal(total(cart), 10.8);
+});
+
+test("discount codes are matched ignoring case and surrounding space", () => {
+  const cart = createCart();
+  assert.equal(applyDiscount(cart, " save10 "), true);
+  assert.equal(cart.discountCode, "SAVE10");
+});
+
+test("unknown discount code is rejected and leaves the cart alone", () => {
+  const cart = createCart();
+  assert.equal(applyDiscount(cart, "NOPE"), false);
+  assert.equal(cart.discountCode, null);
+});
+
+test("addItem rejects quantities and prices that cannot be charged", () => {
+  const cart = createCart();
+  for (const bad of [0, -2, NaN, "3", undefined]) {
+    assert.throws(() => addItem(cart, { sku: "mug", price: 10, qty: bad }), TypeError);
+  }
+  for (const bad of [-1, NaN, "10"]) {
+    assert.throws(() => addItem(cart, { sku: "mug", price: bad, qty: 1 }), TypeError);
+  }
+  assert.equal(cart.items.length, 0);
+  assert.equal(subtotal(cart), 0);
+});
+
+// The checkout page duplicates the pricing tables inline so it works without a
+// build step (public/index.html). This keeps the two copies from drifting.
+function ratesFrom(source, identifier) {
+  const body = source.match(new RegExp(`${identifier}\\s*=\\s*\\{([^}]*)\\}`))?.[1];
+  assert.ok(body, `could not find ${identifier} table`);
+  return Object.fromEntries(
+    [...body.matchAll(/["']?([A-Za-z0-9_-]+)["']?\s*:\s*([\d.]+)/g)].map(([, code, rate]) => [code, Number(rate)]),
+  );
+}
+
+test("checkout page pricing tables match src/cart.js", () => {
+  const module = readFileSync(new URL("../src/cart.js", import.meta.url), "utf8");
+  const page = readFileSync(new URL("../public/index.html", import.meta.url), "utf8");
+  assert.deepEqual(ratesFrom(page, "codes"), ratesFrom(module, "DISCOUNTS"));
+  const pageTax = page.match(/TAX_RATE\s*=\s*([\d.]+)/)?.[1];
+  assert.equal(Number(pageTax), TAX_RATE);
+});
