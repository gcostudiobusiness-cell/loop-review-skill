diff --git a/test/cart.test.js b/test/cart.test.js
index 4fb0303..b330f4f 100644
--- a/test/cart.test.js
+++ b/test/cart.test.js
@@ -19,3 +19,45 @@ test("total includes tax", () => {
   addItem(cart, { sku: "mug", price: 10, qty: 1 });
   assert.equal(total(cart), 12);
 });
+
+test("an applied discount reduces the total", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  applyDiscount(cart, "SAVE10");
+  assert.equal(total(cart), 10.8);
+  applyDiscount(cart, "WELCOME5");
+  assert.equal(total(cart), 11.4);
+});
+
+test("total is rounded to whole pence", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "tea", price: 4.99, qty: 3 });
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  assert.equal(total(cart), 29.96);
+  applyDiscount(cart, "SAVE10");
+  assert.equal(total(cart), 26.97);
+});
+
+test("inherited object keys are not valid discount codes", () => {
+  for (const code of ["constructor", "toString", "valueOf", "__proto__"]) {
+    const cart = createCart();
+    addItem(cart, { sku: "mug", price: 10, qty: 1 });
+    assert.equal(applyDiscount(cart, code), false, `${code} must be rejected`);
+    assert.equal(cart.discountCode, null);
+    assert.equal(total(cart), 12);
+  }
+});
+
+test("addItem rejects prices and quantities that cannot produce a real total", () => {
+  const cart = createCart();
+  assert.throws(() => addItem(cart, { sku: "x", price: -5, qty: 1 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: "abc", qty: 1 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: NaN, qty: 1 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: Infinity, qty: 1 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: 5, qty: 0 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: 5, qty: -2 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: 5, qty: 1.5 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "", price: 5, qty: 1 }), TypeError);
+  assert.equal(cart.items.length, 0);
+  assert.equal(total(cart), 0);
+});
diff --git a/test/pricing-consistency.test.js b/test/pricing-consistency.test.js
new file mode 100644
index 0000000..4d4593f
--- /dev/null
+++ b/test/pricing-consistency.test.js
@@ -0,0 +1,62 @@
+// public/index.html duplicates the pricing facts so the page works without a
+// build step. These tests fail if that copy drifts from src/cart.js.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { createCart, addItem, applyDiscount, total, TAX_RATE } from "../src/cart.js";
+
+const page = readFileSync(fileURLToPath(new URL("../public/index.html", import.meta.url)), "utf8");
+
+function pageConstant(name) {
+  const match = page.match(new RegExp(`const ${name} = ([^;]+);`));
+  assert.ok(match, `${name} not found in public/index.html`);
+  return match[1].trim();
+}
+
+function pageValue(name) {
+  return JSON.parse(pageConstant(name).replace(/(\w+):/g, '"$1":'));
+}
+
+test("the page uses the same tax rate as src/cart.js", () => {
+  assert.equal(Number(pageConstant("TAX_RATE")), TAX_RATE);
+});
+
+test("the page offers the same discount codes at the same rates", () => {
+  const pageCodes = pageValue("codes");
+  for (const [code, rate] of Object.entries(pageCodes)) {
+    const cart = createCart();
+    addItem(cart, { sku: "mug", price: 10, qty: 1 });
+    assert.equal(applyDiscount(cart, code), true, `${code} is not a code src/cart.js knows`);
+    // 10 + 20% tax = 12, less the page's own rate for this code.
+    assert.equal(total(cart), Math.round(12 * (1 - rate) * 100) / 100);
+  }
+  assert.equal(Object.keys(pageCodes).length, 2, "src/cart.js defines 2 codes; the page must list both");
+});
+
+test("the page computes its own basket's total the way src/cart.js does", () => {
+  // Read the basket out of the page rather than restating it, so editing a
+  // price or quantity in public/index.html is still covered by this guard.
+  const pageItems = pageValue("items");
+  const pageTaxRate = Number(pageConstant("TAX_RATE"));
+  const pageCodes = pageValue("codes");
+
+  for (const code of [null, ...Object.keys(pageCodes)]) {
+    const cart = createCart();
+    for (const i of pageItems) addItem(cart, { sku: i.sku, price: i.price, qty: i.qty });
+    if (code) assert.equal(applyDiscount(cart, code), true);
+
+    // The page's own arithmetic, using the page's own constants.
+    const sub = pageItems.reduce((s, i) => s + i.price * i.qty, 0);
+    const taxed = sub * (1 + pageTaxRate);
+    const rate = code ? pageCodes[code] : 0;
+    const asThePageShowsIt = Math.round((taxed - taxed * rate) * 100) / 100;
+
+    assert.equal(total(cart), asThePageShowsIt, `basket total disagrees for code ${code}`);
+  }
+});
+
+test("the page does not build the discount error out of raw user input", () => {
+  assert.ok(!/msg"\)\.innerHTML/.test(page), "#msg must not be written via innerHTML");
+  assert.ok(/msg\.textContent = c \+ " is not valid"/.test(page));
+});
