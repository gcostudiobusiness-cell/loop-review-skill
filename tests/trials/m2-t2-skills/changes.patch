diff --git a/test/markup.test.js b/test/markup.test.js
new file mode 100644
index 0000000..19c3c4b
--- /dev/null
+++ b/test/markup.test.js
@@ -0,0 +1,34 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const html = readFileSync(new URL('../public/index.html', import.meta.url), 'utf8');
+const css = readFileSync(new URL('../public/styles.css', import.meta.url), 'utf8');
+
+test('the page scales to the device width', () => {
+  assert.match(html, /<meta name="viewport" content="width=device-width, initial-scale=1">/);
+  assert.doesNotMatch(css, /\.page\s*\{[^}]*(?<![-\w])width:\s*960px/);
+});
+
+test('every control has a label and the save control is a real button', () => {
+  for (const field of ['name', 'email', 'phone', 'lang']) {
+    assert.match(html, new RegExp(`<label for="${field}">`), `missing label for ${field}`);
+  }
+  assert.match(html, /<button type="submit" class="save" id="save">/);
+});
+
+test('focus is never hidden without a replacement indicator', () => {
+  assert.doesNotMatch(css, /outline:\s*none/);
+  assert.match(css, /:focus-visible[^{]*\{[^}]*outline:\s*2px solid/);
+});
+
+test('each validated field has an error element it describes', () => {
+  for (const field of ['name', 'email', 'phone']) {
+    assert.match(html, new RegExp(`id="${field}"[^>]*aria-describedby="[^"]*${field}-error`));
+    assert.match(html, new RegExp(`id="${field}-error"`));
+  }
+});
+
+test('the save outcome has a live region to report into', () => {
+  assert.match(html, /id="status" role="status" aria-live="polite"/);
+});
