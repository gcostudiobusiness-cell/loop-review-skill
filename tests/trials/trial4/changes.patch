 }
 
 export function addItem(cart, { sku, price, qty }) {
+  if (!Number.isFinite(price) || price < 0) {
+    throw new TypeError(`price must be a non-negative number, got ${price}`);
+  }
+  if (!Number.isFinite(qty) || qty < 0) {
+    throw new TypeError(`qty must be a non-negative number, got ${qty}`);
+  }
   const existing = cart.items.find((i) => i.sku === sku);
   if (existing) {
     existing.qty = qty;
@@ -35,6 +41,8 @@ export function applyDiscount(cart, code) {
 
 export function total(cart) {
   const taxed = subtotal(cart) * (1 + TAX_RATE);
-  const rate = cart.discountCode ? DISCOUNTS[cart.discountCode] : 0;
+  // An unknown code (set directly rather than via applyDiscount) means no
+  // discount; without the fallback the total would silently become NaN.
+  const rate = cart.discountCode ? DISCOUNTS[cart.discountCode] ?? 0 : 0;
   return taxed - taxed * rate;
 }
