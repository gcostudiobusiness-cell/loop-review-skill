 import { test } from "node:test";
 import assert from "node:assert/strict";
-import { createCart, addItem, subtotal, applyDiscount, total } from "../src/cart.js";
+import { readFileSync } from "node:fs";
+import { createCart, addItem, subtotal, applyDiscount, total, TAX_RATE } from "../src/cart.js";
 
 test("subtotal sums line items", () => {
   const cart = createCart();
@@ -19,3 +20,52 @@ test("total includes tax", () => {
   addItem(cart, { sku: "mug", price: 10, qty: 1 });
   assert.equal(total(cart), 12);
 });
+
+test("total applies discount and tax together", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  applyDiscount(cart, "SAVE10");
+  assert.equal(total(cart), 10.8);
+});
+
+test("addItem rejects invalid price or qty", () => {
+  const cart = createCart();
+  assert.throws(() => addItem(cart, { sku: "x", price: -5, qty: 1 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: "abc", qty: 1 }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: 5, qty: NaN }), TypeError);
+  assert.throws(() => addItem(cart, { sku: "x", price: 5, qty: -1 }), TypeError);
+  assert.equal(cart.items.length, 0);
+});
+
+test("unknown discount code does not make the total NaN", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  cart.discountCode = "BOGUS";
+  assert.equal(total(cart), 12);
+});
+
+// The checkout page duplicates the pricing constants so it works without a
+// build step; this guard fails if the discount table or tax rate drift apart.
+// It compares the constants only — the total formula is duplicated too and is
+// NOT covered here (see the remaining-issues note in the review report).
+test("checkout page pricing constants match cart.js", () => {
+  const page = readFileSync(new URL("../public/index.html", import.meta.url), "utf8");
+  const source = readFileSync(new URL("../src/cart.js", import.meta.url), "utf8");
+
+  const grab = (re, text, what) => {
+    const m = re.exec(text);
+    assert.ok(m, `${what} not found — the drift guard needs updating`);
+    return m[1];
+  };
+  const pageCodes = grab(/const codes = \{([^}]*)\}/, page, "page discount table");
+  const sourceCodes = grab(/const DISCOUNTS = \{([^}]*)\}/, source, "cart.js DISCOUNTS");
+  const parse = (s) =>
+    Object.fromEntries(
+      s.split(",").map((p) => p.trim()).filter(Boolean)
+        .map((p) => { const [k, v] = p.split(":"); return [k.trim(), Number(v)]; })
+    );
+  assert.deepEqual(parse(pageCodes), parse(sourceCodes));
+
+  const pageTax = grab(/const TAX_RATE = ([0-9.]+)/, page, "page tax rate");
+  assert.equal(Number(pageTax), TAX_RATE);
+});
