--- a/public/app.js
+++ b/public/app.js
@@ -1,14 +1,83 @@
 import { validate } from './validate.js';
 
 const form = document.getElementById('settings');
-const save = document.getElementById('save');
+const status = document.getElementById('status');
+const FIELDS = ['name', 'email', 'phone'];
 
-save.addEventListener('click', async () => {
-  const data = Object.fromEntries(new FormData(form));
-  const errors = validate(data);
-  for (const field of ['name', 'email', 'phone']) {
-    document.getElementById(field).classList.toggle('invalid', Boolean(errors[field]));
+// Describing hints stay attached; the error id is appended while the error shows.
+const hintIds = new Map(
+  FIELDS.map((field) => [field, document.getElementById(field).getAttribute('aria-describedby') || '']),
+);
+
+function setStatus(message, state) {
+  status.textContent = message;
+  if (state) status.dataset.state = state;
+  else delete status.dataset.state;
+}
+
+function showErrors(errors) {
+  for (const field of FIELDS) {
+    const input = document.getElementById(field);
+    const slot = document.getElementById(`${field}-error`);
+    const message = errors[field];
+
+    input.classList.toggle('invalid', Boolean(message));
+    slot.textContent = message || '';
+    slot.hidden = !message;
+
+    if (message) {
+      input.setAttribute('aria-invalid', 'true');
+      input.setAttribute('aria-describedby', `${hintIds.get(field)} ${field}-error`.trim());
+    } else {
+      input.removeAttribute('aria-invalid');
+      const hint = hintIds.get(field);
+      if (hint) input.setAttribute('aria-describedby', hint);
+      else input.removeAttribute('aria-describedby');
+    }
+  }
+}
+
+function currentErrors() {
+  return validate(Object.fromEntries(new FormData(form)));
+}
+
+let submitted = false;
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const errors = currentErrors();
+  submitted = true;
+  showErrors(errors);
+
+  const invalid = FIELDS.filter((field) => errors[field]);
+  if (invalid.length) {
+    const count = invalid.length;
+    setStatus(
+      `${count} ${count === 1 ? 'field needs' : 'fields need'} attention before saving.`,
+      'error',
+    );
+    // Send the keyboard straight to the first problem.
+    document.getElementById(invalid[0]).focus();
+    return;
+  }
+
+  setStatus('Saving…');
+  try {
+    const response = await fetch('/api/settings', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(Object.fromEntries(new FormData(form))),
+    });
+    if (!response.ok) throw new Error(`Request failed: ${response.status}`);
+    setStatus('Changes saved.');
+  } catch {
+    setStatus('Could not save your changes. Check your connection and try again.', 'error');
   }
-  if (Object.keys(errors).length) return;
-  await fetch('/api/settings', { method: 'PUT', body: JSON.stringify(data) });
 });
+
+// Once a save has been attempted, clear each error as soon as the field is fixed.
+for (const field of FIELDS) {
+  document.getElementById(field).addEventListener('input', () => {
+    if (submitted) showErrors(currentErrors());
+  });
+}
