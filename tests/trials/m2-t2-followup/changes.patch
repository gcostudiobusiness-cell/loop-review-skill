diff --git a/test/validate.test.js b/test/validate.test.js
index 764c590..2543306 100644
--- a/test/validate.test.js
+++ b/test/validate.test.js
@@ -9,3 +9,22 @@ test('accepts valid settings', () => {
 test('requires a display name', () => {
   assert.ok(validate({ name: '', email: 'ana@example.com' }).name);
 });
+
+// The page renders these strings next to each field, so every invalid field
+// must come back with a non-empty message, not just a truthy flag.
+test('returns a message for each invalid field', () => {
+  const errors = validate({ name: '', email: 'not-an-email', phone: 'abc' });
+  for (const field of ['name', 'email', 'phone']) {
+    assert.equal(typeof errors[field], 'string');
+    assert.ok(errors[field].length > 0, `${field} message is empty`);
+  }
+});
+
+test('reports a bad email address', () => {
+  assert.ok(validate({ name: 'Ana', email: 'ana@example' }).email);
+});
+
+test('accepts an empty optional phone but rejects a non-numeric one', () => {
+  assert.equal(validate({ name: 'Ana', email: 'ana@example.com', phone: '' }).phone, undefined);
+  assert.ok(validate({ name: 'Ana', email: 'ana@example.com', phone: 'abc' }).phone);
+});
