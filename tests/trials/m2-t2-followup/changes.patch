diff --git a/public/app.js b/public/app.js
index 8690ea1..0b81a07 100644
--- a/public/app.js
+++ b/public/app.js
@@ -1,14 +1,50 @@
 import { validate } from './validate.js';
 
 const form = document.getElementById('settings');
-const save = document.getElementById('save');
+const status = document.getElementById('status');
 
-save.addEventListener('click', async () => {
+// Writes a validation message next to one field and links it to the input.
+function setFieldError(field, message) {
+  const input = document.getElementById(field);
+  const error = document.getElementById(`${field}-error`);
+  error.textContent = message || '';
+  input.classList.toggle('invalid', Boolean(message));
+  input.setAttribute('aria-invalid', message ? 'true' : 'false');
+}
+
+function setStatus(message, isError) {
+  status.textContent = message;
+  status.classList.toggle('status-error', Boolean(isError));
+}
+
+// Identifies the most recent submit, so a slow earlier save cannot overwrite
+// the status of a later one.
+let currentSubmit = 0;
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const token = ++currentSubmit;
   const data = Object.fromEntries(new FormData(form));
   const errors = validate(data);
   for (const field of ['name', 'email', 'phone']) {
-    document.getElementById(field).classList.toggle('invalid', Boolean(errors[field]));
+    setFieldError(field, errors[field]);
+  }
+  if (Object.keys(errors).length) {
+    setStatus('', false);
+    return;
+  }
+  setStatus('Saving…', false);
+  try {
+    const response = await fetch('/api/settings', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(data)
+    });
+    if (!response.ok) throw new Error(`Request failed: ${response.status}`);
+    if (token === currentSubmit) setStatus('Settings saved.', false);
+  } catch {
+    if (token === currentSubmit) {
+      setStatus('Could not save your settings. Please try again.', true);
+    }
   }
-  if (Object.keys(errors).length) return;
-  await fetch('/api/settings', { method: 'PUT', body: JSON.stringify(data) });
 });
