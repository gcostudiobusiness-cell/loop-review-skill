+// Guards on public/index.html's source. These exist because of one specific
+// defect: the page used to keep its own copy of the prices, the tax rate and the
+// discount table, so WELCOME5 worked in the model and was rejected on the page.
+//
+// They assert the direction of the dependency and the absence of pricing data,
+// and deliberately avoid matching whole tags or exact markup, so cosmetic edits
+// (adding a class, reordering attributes) do not fail the suite.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { discountCodes } from "../src/cart.js";
+
+const html = readFileSync(
+  fileURLToPath(new URL("../public/index.html", import.meta.url)),
+  "utf8",
+);
+const script = html.match(/<script type="module">([\s\S]*?)<\/script>/)[1];
+// The markup alone: CSS lengths like `width: 100%` and script text are not
+// user-visible copy, so percentage and price checks must not see them.
+const markup = html
+  .replace(/<style>[\s\S]*?<\/style>/, "")
+  .replace(/<script[\s\S]*?<\/script>/, "");
+
+test("the page imports its pricing from src/cart.js", () => {
+  assert.match(html, /<script\s+type="module"\s*>/);
+  assert.match(script, /from\s+"\.\.\/src\/cart\.js"/);
+});
+
+test("the page holds no pricing data of its own", () => {
+  // Derived from the module, so adding a code to DISCOUNTS is covered for free.
+  for (const code of discountCodes()) {
+    assert.ok(!html.includes(code), `${code} must not appear in the page`);
+  }
+  assert.ok(!/\bprice\s*:/.test(script), "no item/price literals in the page");
+  // Any spelling of a tax rate: a multiplier, a fraction, or a "20%" label.
+  assert.ok(!/\b1\.2\d*\b|\b0\.2\d*\b/.test(script), "no hardcoded tax rate");
+  assert.ok(
+    !/\d+(\.\d+)?\s*%/.test(markup),
+    "the tax label must come from taxLabel(), not a hardcoded percentage",
+  );
+});
+
+test("user input never reaches an HTML sink", () => {
+  assert.ok(
+    !/\.(innerHTML|outerHTML)\s*=|insertAdjacentHTML|document\.write/.test(html),
+    "markup is built with textContent and createElement only",
+  );
+  assert.ok(!/\son\w+\s*=\s*["']/.test(html), "no inline event-handler attributes");
+});
+
+test("the page's controls are keyboard-operable and labelled", () => {
+  // Attribute-level assertions: real buttons, a labelled input, a live region.
+  assert.match(html, /<button[^>]*type="submit"/);
+  assert.match(html, /<button[^>]*type="button"[^>]*id="pay"/);
+  assert.match(html, /<label[^>]*for="code"/);
+  assert.match(html, /id="code"/);
+  assert.match(html, /id="msg"[^>]*aria-live="polite"/);
+  assert.match(html, /id="code"[^>]*aria-describedby="msg"/);
+  assert.match(html, /name="viewport"/);
+  assert.match(html, /id="items"[^>]*role="list"/);
+  assert.match(html, /:focus-visible/);
+});
