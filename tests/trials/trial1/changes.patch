-  const taxed = subtotal(cart) * (1 + TAX_RATE);
-  const rate = cart.discountCode ? DISCOUNTS[cart.discountCode] : 0;
-  return taxed - taxed * rate;
+  return priceBreakdown(cart).total;
 }
