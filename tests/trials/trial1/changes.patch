+  assert.match(taxLabel(), /^VAT \(\d+(\.\d+)?%\)$/);
+});
+
+test("the catalogue and discount table cannot be mutated", () => {
+  assert.throws(() => {
+    CATALOGUE[0].price = 0;
+  }, TypeError);
+  assert.throws(() => {
+    CATALOGUE.push({ sku: "x", price: 1, qty: 1 });
+  }, TypeError);
+});
+
+test("addItem carries the display name onto the cart item", () => {
+  const cart = createCart();
+  addItem(cart, CATALOGUE[0]);
+  assert.equal(cart.items[0].name, CATALOGUE[0].name);
+  // Without a name, the sku stands in rather than rendering "undefined".
+  addItem(cart, { sku: "bare", price: 1, qty: 1 });
+  assert.equal(cart.items[1].name, "bare");
+});
diff --git a/test/page.test.js b/test/page.test.js
