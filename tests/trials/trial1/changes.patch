 // Cart pricing logic for the checkout page.
+// This module is the single source of truth for prices, tax and discount codes:
+// public/index.html imports it directly rather than keeping its own copy.
 
 export const TAX_RATE = 0.2;
 
-const DISCOUNTS = {
+export const CURRENCY = "GBP";
+
+// Frozen so a bug on the page cannot quietly rewrite the source of truth.
+const DISCOUNTS = Object.freeze({
   SAVE10: 0.1,
   WELCOME5: 0.05,
-};
+});
+
+// Seed data for the basket shown on the checkout page. Read once at load; the
+// cart built from it is what gets rendered and priced.
+export const CATALOGUE = Object.freeze([
+  Object.freeze({ sku: "tea", name: "Loose tea", price: 4.99, qty: 3 }),
+  Object.freeze({ sku: "mug", name: "Mug", price: 10, qty: 1 }),
+]);
+
+// Money is rounded once, here, so every caller (page, receipt, tests) agrees to
+// the penny. Rendering must never be where rounding is decided.
+export function roundMoney(value) {
+  return Math.round((value + Number.EPSILON) * 100) / 100;
+}
+
+const moneyFormatter = new Intl.NumberFormat("en-GB", {
+  style: "currency",
+  currency: CURRENCY,
+});
+
+export function formatMoney(value) {
+  return moneyFormatter.format(roundMoney(value));
+}
+
+// The label the page shows next to the tax line, derived from TAX_RATE so the
+// page can never advertise a rate it does not charge.
+export function taxLabel() {
+  return `VAT (${roundMoney(TAX_RATE * 100)}%)`;
+}
+
+export function isValidDiscountCode(code) {
+  // Object.hasOwn, not `DISCOUNTS[code] !== undefined`: a bare lookup accepts
+  // inherited keys such as "constructor" or "__proto__" and poisons the total.
+  return typeof code === "string" && Object.hasOwn(DISCOUNTS, code);
+}
+
+export function discountRate(code) {
+  return isValidDiscountCode(code) ? DISCOUNTS[code] : 0;
+}
+
+export function discountCodes() {
+  return Object.keys(DISCOUNTS);
+}
 
 export function createCart() {
   return { items: [], discountCode: null };
 }
 
-export function addItem(cart, { sku, price, qty }) {
+export function addItem(cart, { sku, name, price, qty }) {
+  if (!Number.isFinite(price) || price < 0) {
+    throw new RangeError(`price must be a non-negative number, got ${price}`);
+  }
+  if (!Number.isInteger(qty) || qty < 0) {
+    throw new RangeError(`qty must be a non-negative integer, got ${qty}`);
+  }
   const existing = cart.items.find((i) => i.sku === sku);
   if (existing) {
+    // Note: this sets the quantity rather than adding to it.
     existing.qty = qty;
+    existing.price = price;
+    if (name !== undefined) existing.name = name;
   } else {
-    cart.items.push({ sku, price, qty });
+    cart.items.push({ sku, name: name ?? sku, price, qty });
   }
   return cart;
 }
 
+// The one rounding rule for a basket line, so the rows the customer reads always
+// add up to the subtotal beneath them.
+export function lineTotal(item) {
+  return roundMoney(item.price * item.qty);
+}
+
 export function subtotal(cart) {
-  return cart.items.reduce((sum, i) => sum + i.price * i.qty, 0);
+  return roundMoney(cart.items.reduce((sum, i) => sum + lineTotal(i), 0));
 }
 
 export function applyDiscount(cart, code) {
-  if (DISCOUNTS[code] !== undefined) {
+  if (isValidDiscountCode(code)) {
     cart.discountCode = code;
     return true;
   }
+  // A rejected code leaves any previously applied code in place — callers that
+  // want it gone must call removeDiscount explicitly.
   return false;
 }
 
+export function removeDiscount(cart) {
+  const had = cart.discountCode !== null;
+  cart.discountCode = null;
+  return had;
+}
+
+// Discount applies to the pre-tax subtotal, then tax is charged on what the
+// customer actually pays. The discount is rounded to the penny before tax, so
+// the tax figure matches the discounted amount the customer is shown.
+export function priceBreakdown(cart) {
+  const sub = subtotal(cart);
+  const discount = roundMoney(sub * discountRate(cart.discountCode));
+  const taxable = roundMoney(sub - discount);
+  const tax = roundMoney(taxable * TAX_RATE);
+  return {
+    subtotal: sub,
+    discount,
+    tax,
+    total: roundMoney(taxable + tax),
+  };
+}
+
