diff --git a/test/bookings.test.js b/test/bookings.test.js
index 24fa893..ee50f4f 100644
--- a/test/bookings.test.js
+++ b/test/bookings.test.js
@@ -1,6 +1,6 @@
 import { test } from 'node:test';
 import assert from 'node:assert/strict';
-import { addBooking, freeSlots } from '../src/bookings.js';
+import { addBooking, freeSlots, overlaps } from '../src/bookings.js';
 
 test('accepts bookings at different times', () => {
   const schedule = [];
@@ -18,3 +18,78 @@ test('lists free slots around a booking', () => {
   const schedule = [{ room: 'Oak', start: '10:00', end: '11:00', who: 'Ana' }];
   assert.equal(freeSlots(schedule, 'Oak', '09:00', '17:00').length, 2);
 });
+
+test('accepts a booking starting exactly when another ends', () => {
+  const schedule = [{ room: 'Oak', start: '09:00', end: '10:00', who: 'Ana' }];
+  const result = addBooking(schedule, { room: 'Oak', start: '10:00', end: '11:00', who: 'Ben' });
+  assert.equal(result.ok, true);
+  assert.equal(schedule.length, 2);
+});
+
+test('still rejects a booking that starts one minute before another ends', () => {
+  const schedule = [{ room: 'Oak', start: '09:00', end: '10:00', who: 'Ana' }];
+  assert.equal(addBooking(schedule, { room: 'Oak', start: '09:59', end: '11:00', who: 'Ben' }).ok, false);
+});
+
+test('rejects an identical booking in the same room', () => {
+  const schedule = [{ room: 'Oak', start: '09:00', end: '10:00', who: 'Ana' }];
+  assert.equal(addBooking(schedule, { room: 'Oak', start: '09:00', end: '10:00', who: 'Ben' }).ok, false);
+});
+
+test('back-to-back bookings leave no gap between them', () => {
+  // Minutes are what matter here; formatMinutes does not pad them (see src/format.js).
+  const schedule = [
+    { room: 'Oak', start: '09:00', end: '10:00', who: 'Ana' },
+    { room: 'Oak', start: '10:00', end: '11:00', who: 'Ben' },
+  ];
+  assert.deepEqual(freeSlots(schedule, 'Oak', '09:00', '11:00'), []);
+  assert.deepEqual(freeSlots(schedule, 'Oak', '09:00', '17:00'), ['11:0-17:0']);
+});
+
+test('free slots end exactly when a booking ends', () => {
+  const schedule = [{ room: 'Oak', start: '09:00', end: '10:00', who: 'Ana' }];
+  assert.deepEqual(freeSlots(schedule, 'Oak', '09:00', '17:00'), ['10:0-17:0']);
+});
+
+// overlaps() is where the clash verdict is produced, so assert it directly and
+// in both directions: a one-sided `<=` would otherwise slip through addBooking.
+test('overlaps is false for touching ranges in either order', () => {
+  const earlier = { start: '09:00', end: '10:00' };
+  const later = { start: '10:00', end: '11:00' };
+  assert.equal(overlaps(earlier, later), false);
+  assert.equal(overlaps(later, earlier), false);
+});
+
+test('overlaps is true for a one-minute encroachment in either order', () => {
+  const earlier = { start: '09:00', end: '10:00' };
+  const later = { start: '09:59', end: '11:00' };
+  assert.equal(overlaps(earlier, later), true);
+  assert.equal(overlaps(later, earlier), true);
+});
+
+test('accepts a booking ending exactly when another starts', () => {
+  const schedule = [{ room: 'Oak', start: '10:00', end: '11:00', who: 'Ana' }];
+  assert.equal(addBooking(schedule, { room: 'Oak', start: '08:00', end: '10:00', who: 'Ben' }).ok, true);
+});
+
+test('rejects a booking ending one minute after another starts', () => {
+  const schedule = [{ room: 'Oak', start: '10:00', end: '11:00', who: 'Ana' }];
+  assert.equal(addBooking(schedule, { room: 'Oak', start: '08:00', end: '10:01', who: 'Ben' }).ok, false);
+});
+
+test('three chained back-to-back bookings leave no gap', () => {
+  const schedule = [
+    { room: 'Oak', start: '09:00', end: '10:00', who: 'Ana' },
+    { room: 'Oak', start: '10:00', end: '11:00', who: 'Ben' },
+    { room: 'Oak', start: '11:00', end: '12:00', who: 'Cal' },
+  ];
+  assert.deepEqual(freeSlots(schedule, 'Oak', '09:00', '12:00'), []);
+});
+
+test('free slots are ordered by time, not by string, for single-digit hours', () => {
+  const schedule = [
+    { room: 'Oak', start: '10:00', end: '11:00', who: 'Ben' },
+    { room: 'Oak', start: '9:00', end: '10:00', who: 'Ana' },
+  ];
+  assert.deepEqual(freeSlots(schedule, 'Oak', '09:00', '17:00'), ['11:0-17:0']);
+});
