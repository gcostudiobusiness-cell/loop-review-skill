-// Storage. Started moving file access here; only search uses it so far.
+// Storage. Owns the notes file path and every read and write of it.
 import fs from 'node:fs';
-import { fileURLToPath } from 'node:url';
-import { formatNote } from './commands.js';
+import path from 'node:path';
 
-const FILE = process.env.NOTES_FILE || fileURLToPath(new URL('../notes.json', import.meta.url));
-let cache = null;
+// Resolved per call, so the path is never frozen at import time.
+function notesFile() {
+  return process.env.NOTES_FILE || path.join(process.cwd(), 'notes.json');
+}
 
-function load() {
-  if (!cache) cache = fs.existsSync(FILE) ? JSON.parse(fs.readFileSync(FILE, 'utf8')) : [];
-  return cache;
+// Reads the notes file, throwing if it is missing. `list` relies on that.
+export function readNotes() {
+  return JSON.parse(fs.readFileSync(notesFile(), 'utf8'));
 }
 
-export function searchNotes(term) {
-  return load()
-    .filter((n) => n.text.toLowerCase().includes(term.toLowerCase()))
-    .map(formatNote);
+// Same, but a missing file counts as an empty notebook.
+export function readNotesOrEmpty() {
+  return fs.existsSync(notesFile()) ? readNotes() : [];
 }
 
-// Old v1 format was { title, body }. Kept in case we need it.
-export function migrateV1(notes) {
-  return notes.map((n, i) => ({ id: i + 1, text: `${n.title}: ${n.body}` }));
+export function writeNotes(notes) {
+  fs.writeFileSync(notesFile(), JSON.stringify(notes, null, 2));
+}
+
+// Returns the matching notes; callers decide how to display them.
+export function searchNotes(term) {
+  const needle = term.toLowerCase();
+  return readNotesOrEmpty().filter((n) => n.text.toLowerCase().includes(needle));
 }
