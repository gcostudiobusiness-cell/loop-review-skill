diff --git a/test/cart.test.js b/test/cart.test.js
index 4fb0303..76df171 100644
--- a/test/cart.test.js
+++ b/test/cart.test.js
@@ -1,6 +1,7 @@
 import { test } from "node:test";
 import assert from "node:assert/strict";
-import { createCart, addItem, subtotal, applyDiscount, total } from "../src/cart.js";
+import { readFile } from "node:fs/promises";
+import { createCart, addItem, subtotal, applyDiscount, total, TAX_RATE, DISCOUNTS } from "../src/cart.js";
 
 test("subtotal sums line items", () => {
   const cart = createCart();
@@ -19,3 +20,45 @@ test("total includes tax", () => {
   addItem(cart, { sku: "mug", price: 10, qty: 1 });
   assert.equal(total(cart), 12);
 });
+
+test("inherited object properties are not discount codes", () => {
+  const cart = createCart();
+  for (const code of ["__proto__", "toString", "constructor", "hasOwnProperty"]) {
+    assert.equal(applyDiscount(cart, code), false);
+  }
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  assert.equal(total(cart), 12);
+});
+
+test("total rounds to whole pence", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "tea", price: 4.99, qty: 3 });
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  assert.equal(total(cart), 29.96);
+});
+
+test("discount is applied before tax", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  applyDiscount(cart, "SAVE10");
+  assert.equal(total(cart), 10.8);
+});
+
+test("a rejected code clears any discount already applied", () => {
+  const cart = createCart();
+  addItem(cart, { sku: "mug", price: 10, qty: 1 });
+  applyDiscount(cart, "SAVE10");
+  assert.equal(applyDiscount(cart, "NOPE"), false);
+  assert.equal(total(cart), 12);
+});
+
+test("the checkout page mirrors the pricing constants", async () => {
+  const page = await readFile(new URL("../public/index.html", import.meta.url), "utf8");
+  const read = (name) => {
+    const match = page.match(new RegExp(`const ${name} = ([^;]+);`));
+    assert.ok(match, `public/index.html declares no ${name}`);
+    return new Function(`return ${match[1]}`)();
+  };
+  assert.equal(read("TAX_RATE"), TAX_RATE);
+  assert.deepEqual(read("DISCOUNTS"), DISCOUNTS);
+});
